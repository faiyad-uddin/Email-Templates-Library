<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>OTP Verification</title>

  <style>
    body { font-family: Arial, sans-serif; background: #f3f3f3; margin: 0; padding: 0; }
    .container { max-width: 600px; background: #ffffff; margin: auto; padding: 25px; border-radius: 6px; }
    .otp-box { font-size: 28px; font-weight: bold; text-align: center; padding: 15px; background: #f0f0f0; border-radius: 6px; margin: 20px 0; letter-spacing: 4px; }
    .footer { font-size: 12px; text-align: center; color: #777; margin-top: 25px; }
  </style>
</head>

<body>
  <div class="container">
    <h2>Verification Code</h2>
    <p>Hello {{first_name}},</p>
    <p>Your one-time verification code is:</p>

    <div class="otp-box">{{otp_code}}</div>

    <p>This code will expire in {{otp_expiry}} minutes.</p>

    <div class="footer">
      <p>If you did not request this code, please ignore this email.</p>
      <p>{{unsubscribe_link}}</p>
    </div>
  </div>
</body>
</html>
